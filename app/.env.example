# Copy this file to app/.env and fill in real values.
# app/.env must never be committed (see .gitignore) and should be chmod 640.

# Absolute public URL of the application (must be https://, no trailing slash).
# Every redirect is built from this value, never from request headers.
APP_URL=https://localhost/food_stock

# Send Strict-Transport-Security. Keep false on localhost (HSTS would stick
# to "localhost" in your browser for every other project), true in production.
APP_HSTS=false

# MariaDB connection - use the least-privilege account from sql/02_app_user.sql.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Time zone used for "today" (default storage date, expiry highlights). Default: UTC.
APP_TIMEZONE=Europe/Paris

# Highlight stock entries expiring within this many days (0-365). Default: 7.
EXPIRY_WARNING_DAYS=7
